<?xml version="1.0" encoding="UTF-8"?>
<faces-config xmlns="http://xmlns.jcp.org/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
              http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_2.xsd"
              version="2.2">

    <!--
        Configuración de Internacionalización (i18n) - ATALAia
        Locale "en" fuerza el punto (.) como separador decimal en lugar de la
        coma (,) que usa la locale es_MX del servidor JVM.
        En México, el contexto financiero utiliza punto para decimales.
    -->
    <application>
        <locale-config>
            <!-- Locale por defecto: inglés (punto decimal) -->
            <default-locale>en</default-locale>
            <!-- También se soporta español de México -->
            <supported-locale>es_MX</supported-locale>
        </locale-config>
    </application>

</faces-config>
